<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MyApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyApp"
    xmlns:models="using:MyApp.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{StaticResource NoteBodyBrush}">
        <Grid.Resources>
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="NoteHoverTintBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="NotePressedTintBrush" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="DragRegion" Grid.Row="0" Background="{StaticResource NoteHeaderBrush}">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="AllowFocusOnInteraction" Value="False"/>
                </Style>
                <Style x:Key="TabArrowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="AllowFocusOnInteraction" Value="False"/>
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ToggleSwitch x:Name="AutoSaveToggleSwitch" Grid.Column="1" Margin="12,0,0,0"
                          AllowFocusOnInteraction="False"
                          VerticalAlignment="Center" OffContent="{x:Null}" OnContent="{x:Null}"
                          ToolTipService.ToolTip="Autosave"
                          IsOn="{x:Bind ViewModel.Settings.Editor.AutoSave, Mode=TwoWay}" MinWidth="0">
                <ToggleSwitch.Resources>
                    <x:Double x:Key="ToggleSwitchPreContentMargin">6</x:Double>
                    <x:Double x:Key="ToggleSwitchPostContentMargin">6</x:Double>
                </ToggleSwitch.Resources>
            </ToggleSwitch>

            <Grid x:Name="TabStrip" Grid.Column="2" HorizontalAlignment="Left" Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ScrollTabsLeftButton" Grid.Column="0"
                        Style="{StaticResource TabArrowButtonStyle}"
                        ToolTipService.ToolTip="Scroll left"
                        Click="ScrollTabsLeft_Click">
                    <FontIcon Glyph="&#xE76B;" FontSize="10"/>
                </Button>

                <ScrollViewer x:Name="TabScroller" Grid.Column="1" IsTabStop="False" AllowFocusOnInteraction="False"
                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TabItems" ItemsSource="{x:Bind ViewModel.Tabs}"
                                  IsTabStop="False" AllowFocusOnInteraction="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NoteTab">
                                <Grid Height="26" ColumnSpacing="4"
                                      Background="Transparent"
                                      ToolTipService.ToolTip="{x:Bind FilePath, Mode=OneWay}"
                                      PointerPressed="Tab_PointerPressed"
                                      PointerEntered="Tab_PointerEntered"
                                      PointerExited="Tab_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.ColumnSpan="3" CornerRadius="4"
                                            Background="{StaticResource NoteActiveTabBrush}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}"/>
                                    <Border x:Name="HoverBorder" Grid.ColumnSpan="3" CornerRadius="4"
                                            Background="{StaticResource NoteHoverTintBrush}" Opacity="0"/>

                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" MaxWidth="120" Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource NoteTextBrush}"/>
                                    <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{StaticResource NoteTextBrush}"
                                             Visibility="{x:Bind IsDirty, Mode=OneWay}"/>
                                    <Button Grid.Column="2" Width="20" Height="20" Padding="0" Margin="0,0,3,0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="3"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Close"
                                            Click="CloseTab_Click">
                                        <FontIcon Glyph="&#xE711;" FontSize="9"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button x:Name="ScrollTabsRightButton" Grid.Column="2"
                        Style="{StaticResource TabArrowButtonStyle}"
                        ToolTipService.ToolTip="Scroll right"
                        Click="ScrollTabsRight_Click">
                    <FontIcon Glyph="&#xE76C;" FontSize="10"/>
                </Button>

                <Button x:Name="NewTabButton" Grid.Column="3" Width="26" Height="26" Padding="0" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0" CornerRadius="4"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="New note (Ctrl+N)"
                        Click="NewFile_Click">
                    <FontIcon Glyph="&#xE710;" FontSize="11"/>
                </Button>
            </Grid>

            <Button Grid.Column="3"
                    x:Name="OnTopButton"
                    Content="&#xE718;"
                    FontFamily="Segoe Fluent Icons"
                    Width="46"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Click="StayOnTop_Click"/>
            <Button Grid.Column="4"
                    Content="&#xE921;"
                    FontFamily="Segoe Fluent Icons"
                    Width="46"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Click="Minimize_Click" />
            <Button Grid.Column="5"
                    Content="&#xE8BB;"
                    FontFamily="Segoe Fluent Icons"
                    Width="46"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Click="Close_Click" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource NoteMenuBarBrush}"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <MenuBar Grid.Column="0" VerticalAlignment="Center">
                <MenuBarItem x:Name="FileMenu" Title="File" AllowFocusOnInteraction="False">
                    <MenuFlyoutSubItem x:Name="NewMenu" Text="New" />
                    <MenuFlyoutItem Text="New window" Click="NewWindow_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+N" />
                    <MenuFlyoutItem Text="Open" Click="OpenFile_Click" KeyboardAcceleratorTextOverride="Ctrl+O" />
                    <MenuFlyoutSubItem x:Name="RecentMenu" Text="Recent" />
                    <MenuFlyoutItem Text="Save" Click="Save_Click" KeyboardAcceleratorTextOverride="Ctrl+S" />
                    <MenuFlyoutItem Text="Save as" Click="SaveAs_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" />
                    <MenuFlyoutItem Text="Save all" Click="SaveAll_Click" KeyboardAcceleratorTextOverride="Ctrl+Alt+S" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Close tab" Click="CloseTab_MenuClick" KeyboardAcceleratorTextOverride="Ctrl+W" />
                    <MenuFlyoutItem Text="Close window" Click="CloseWindow_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+W" />
                    <MenuFlyoutItem Text="Exit" Click="CloseWindow_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Edit" AllowFocusOnInteraction="False">
                    <MenuFlyoutItem Text="Undo" Click="Undo_Click" KeyboardAcceleratorTextOverride="Ctrl+Z"
                                    IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Cut" Click="Cut_Click" KeyboardAcceleratorTextOverride="Ctrl+X"
                                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    <MenuFlyoutItem Text="Copy" Click="Copy_Click" KeyboardAcceleratorTextOverride="Ctrl+C"
                                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    <MenuFlyoutItem Text="Paste" Click="Paste_Click" KeyboardAcceleratorTextOverride="Ctrl+V" />
                    <MenuFlyoutItem Text="Delete" Click="Delete_Click" KeyboardAcceleratorTextOverride="Del"
                                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Clear formatting" Click="ClearFormatting_Click"
                                    IsEnabled="{x:Bind ViewModel.CanClearFormatting, Mode=OneWay}" />
                    <MenuFlyoutItem Text="Define with Bing" Click="Define_Click" KeyboardAcceleratorTextOverride="Ctrl+E" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Find" Click="Find_Click" KeyboardAcceleratorTextOverride="Ctrl+F" />
                    <MenuFlyoutItem Text="Find next" Click="FindNext_Click" KeyboardAcceleratorTextOverride="F3" />
                    <MenuFlyoutItem Text="Find previous" Click="FindPrevious_Click" KeyboardAcceleratorTextOverride="Shift+F3" />
                    <MenuFlyoutItem Text="Replace" Click="Replace_Click" KeyboardAcceleratorTextOverride="Ctrl+H" />
                    <MenuFlyoutItem Text="Go to" Click="GoTo_Click" KeyboardAcceleratorTextOverride="Ctrl+G" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Select all" Click="SelectAll_Click" KeyboardAcceleratorTextOverride="Ctrl+A" />
                </MenuBarItem>

                <MenuBarItem Title="View" AllowFocusOnInteraction="False">
                    <ToggleMenuFlyoutItem Text="AI chat" Click="MenuItem_RefocusEditor"
                                          IsChecked="{x:Bind ViewModel.Settings.Appearance.ShowChatPanel, Mode=TwoWay}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Zoom">
                        <MenuFlyoutItem Text="Zoom in" Click="ZoomIn_Click" KeyboardAcceleratorTextOverride="Ctrl+Plus" />
                        <MenuFlyoutItem Text="Zoom out" Click="ZoomOut_Click" KeyboardAcceleratorTextOverride="Ctrl+Minus" />
                        <MenuFlyoutItem Text="Restore default zoom" Click="ResetZoom_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                    </MenuFlyoutSubItem>
                </MenuBarItem>
            </MenuBar>

            <ToggleButton x:Name="ChatToggleButton" Grid.Column="1"
                          Style="{StaticResource NoteBoxButtonStyle}"
                          Width="32" Height="28" Margin="0,0,2,0"
                          ToolTipService.ToolTip="AI chat"
                          IsChecked="{x:Bind ViewModel.Settings.Appearance.ShowChatPanel, Mode=TwoWay}">
                <FontIcon Glyph="&#xE8BD;" FontSize="13" />
            </ToggleButton>

            <local:FormattingToolbar x:Name="FormattingToolbarControl" Grid.Column="2" Margin="0,0,4,0" />

            <Button x:Name="SettingsButton" Grid.Column="3"
                    Width="40" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0" CornerRadius="0"
                    AllowFocusOnInteraction="False"
                    ToolTipService.ToolTip="Settings"
                    Click="SettingsButton_Click">
                <FontIcon Glyph="&#xE713;" FontSize="15" />
            </Button>
        </Grid>

        <Grid x:Name="ContentArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="ChatColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Frame x:Name="RootFrame" Grid.Column="0" />
            <local:PanelSplitter x:Name="ChatSplitter" Grid.Column="1" Visibility="Collapsed" />
            <local:ChatPanel x:Name="ChatPanelControl" Grid.Column="2" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource NoteMenuBarBrush}" Padding="12,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="12">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Opacity" Value="0.8" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{StaticResource NoteTextBrush}" />
                    </Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Height" Value="12" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Fill" Value="{StaticResource NoteBorderBrush}" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="{x:Bind ViewModel.StatusPosition, Mode=OneWay}" />
                <Rectangle />
                <TextBlock Text="{x:Bind ViewModel.StatusCounts, Mode=OneWay}" />
                <Rectangle />
                <TextBlock Text="{x:Bind ViewModel.StatusFileType, Mode=OneWay}" />
                <Rectangle />
                <TextBlock Text="{x:Bind ViewModel.StatusZoom, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="4"
              Background="{StaticResource NoteBodyBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style x:Key="SettingsCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource NoteMenuBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource NoteBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Padding" Value="16,12" />
                </Style>
                <Style x:Key="SettingsSectionStyle" TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="0,12,0,0" />
                    <Setter Property="Foreground" Value="{StaticResource NoteTextBrush}" />
                </Style>
            </Grid.Resources>
            <Grid x:Name="SettingsHeader" Grid.Row="0" Background="{StaticResource NoteHeaderBrush}"
                  SizeChanged="SettingsHeader_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CloseSettingsButton" Grid.Column="0"
                        Width="46" VerticalAlignment="Stretch" Padding="0"
                        Background="Transparent" BorderThickness="0" CornerRadius="0"
                        AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="Back (Esc)"
                        Click="CloseSettings_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Grid.Column="1" Text="Settings" Margin="6,0,0,0" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource NoteTextBrush}" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24,8,24,24" Spacing="8" MaxWidth="640">
                    <TextBlock Text="Editor" Style="{StaticResource SettingsSectionStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Autosave" Foreground="{StaticResource NoteTextBrush}" />
                                <TextBlock Text="Save the note a moment after you stop typing"
                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                           Foreground="{StaticResource NoteTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"
                                          IsOn="{x:Bind ViewModel.Settings.Editor.AutoSave, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Theme" Foreground="{StaticResource NoteTextBrush}" />
                            <RadioButtons x:Name="ThemeRadioButtons"
                                          Foreground="{StaticResource NoteTextBrush}"
                                          SelectionChanged="ThemeRadioButtons_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
