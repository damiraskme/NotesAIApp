<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="NoteBoxButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource NoteTextBrush}" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>

        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="NoteHoverTintBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="NotePressedTintBrush" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />

        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="NoteHoverTintBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="NotePressedTintBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="NoteCheckedBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="NoteCheckedHoverBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="NoteCheckedHoverBrush" />
        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="NoteTextBrush" />
        <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="NoteTextBrush" />
        <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="NoteTextBrush" />
        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="NoteCheckedTextBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="NoteCheckedTextBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="NoteCheckedTextBrush" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
    </Page.Resources>

    <Grid Padding="12,4,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <RichEditBox x:Name="NoteTextBox"
                     Grid.Row="0"
                     PlaceholderText="Take a note..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     Padding="4"
                     FontSize="15"
                     Foreground="{StaticResource NoteTextBrush}"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     TextChanged="NoteBoxControl"
                     SelectionChanged="NoteTextBox_SelectionChanged">
            <RichEditBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <StaticResource x:Key="TextControlForeground" ResourceKey="NoteTextBrush" />
                <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="NoteTextBrush" />
                <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="NoteTextBrush" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </RichEditBox.Resources>
        </RichEditBox>

        <InfoBar x:Name="PythonInfoBar"
                 Grid.Row="1"
                 Margin="0,4,0,4"
                 IsOpen="False"
                 IsClosable="True" />

        <Grid Grid.Row="2" ColumnSpacing="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="BoldButton" Grid.Column="0"
                    Style="{StaticResource NoteBoxButtonStyle}"
                    ToolTipService.ToolTip="Bold (Ctrl+B)"
                    Click="BoldButton_Click">
                <FontIcon Glyph="&#xE8DD;" FontSize="14" />
            </ToggleButton>

            <ToggleButton x:Name="ItalicButton" Grid.Column="1"
                    Style="{StaticResource NoteBoxButtonStyle}"
                    ToolTipService.ToolTip="Italic (Ctrl+I)"
                    Click="ItalicButton_Click">
                <FontIcon Glyph="&#xE8DB;" FontSize="14" />
            </ToggleButton>

            <ToggleButton x:Name="UnderlineButton" Grid.Column="2"
                    Style="{StaticResource NoteBoxButtonStyle}"
                    ToolTipService.ToolTip="Underline (Ctrl+U)"
                    Click="UnderlineButton_Click">
                <FontIcon Glyph="&#xE8DC;" FontSize="14" />
            </ToggleButton>

            <ToggleButton x:Name="StrikethroughButton" Grid.Column="3"
                    Style="{StaticResource NoteBoxButtonStyle}"
                    ToolTipService.ToolTip="Strikethrough"
                    Click="StrikethroughButton_Click">
                <FontIcon Glyph="&#xEDE0;" FontSize="14" />
            </ToggleButton>

            <ToggleButton x:Name="ListButton" Grid.Column="4"
                    Style="{StaticResource NoteBoxButtonStyle}"
                    ToolTipService.ToolTip="List (right-click for style)"
                    Click="ListButton_Click">
                <ToggleButton.ContextFlyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem x:Name="BulletListItem" Text="Bullets"
                                             GroupName="ListStyle" IsChecked="True"
                                             Click="ListStyleItem_Click">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="NumberedListItem" Text="Numbers (1, 2, 3)"
                                             GroupName="ListStyle"
                                             Click="ListStyleItem_Click" />
                    </MenuFlyout>
                </ToggleButton.ContextFlyout>
                <Grid>
                    <FontIcon x:Name="BulletListIcon" Glyph="&#xE8FD;" FontSize="14" />
                    <TextBlock x:Name="NumberedListIcon" Text="123" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </ToggleButton>

            <Button x:Name="PythonButton" Grid.Column="5"
                    AllowFocusOnInteraction="False"
                    Height="36"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Stretch"
                    CornerRadius="4"
                    BorderThickness="0"
                    Background="{StaticResource NoteAccentBrush}"
                    Foreground="{StaticResource NoteAccentTextBrush}"
                    ToolTipService.ToolTip="Run Python backend"
                    Click="PythonButton_Click">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="NoteAccentHoverBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="NoteAccentHoverBrush" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="NoteAccentTextBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="NoteAccentTextBrush" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PythonIcon" Glyph="&#xE945;" FontSize="14" />
                    <ProgressRing x:Name="PythonProgress" Width="14" Height="14"
                                  IsActive="False" Visibility="Collapsed" />
                    <TextBlock Text="Run" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
