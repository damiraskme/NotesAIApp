<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:String x:Key="NoteBaseTheme">Light</x:String>

    <Color x:Key="NoteBodyColor">#F9F9F9</Color>
    <Color x:Key="NoteMenuBarColor">#F0F0F0</Color>
    <Color x:Key="NoteHeaderColor">#E8E8E8</Color>
    <Color x:Key="NoteActiveTabColor">#F9F9F9</Color>
    <Color x:Key="NoteMenuColor">#FCFCFC</Color>

    <Color x:Key="NoteTextColor">#1A1A1A</Color>
    <Color x:Key="NoteBorderColor">#1F000000</Color>

    <Color x:Key="NoteAccentColor">#005FB8</Color>
    <Color x:Key="NoteAccentHoverColor">#196EBF</Color>
    <Color x:Key="NoteAccentTextColor">#FFFFFF</Color>

    <Color x:Key="NoteHoverTintColor">#0F000000</Color>
    <Color x:Key="NotePressedTintColor">#1A000000</Color>

    <Color x:Key="NoteCheckedColor">#005FB8</Color>
    <Color x:Key="NoteCheckedHoverColor">#196EBF</Color>
    <Color x:Key="NoteCheckedTextColor">#FFFFFF</Color>

</ResourceDictionary>
